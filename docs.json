{
  "theme": "maple",
  "name": "EcoWestern Support",
  "colors": {
    "primary": "#086d00",
    "light": "#086d00",
    "dark": "#8fcf76"
  },
  "favicon": {
    "light": "/images/ecowesternicon(1).png",
    "dark": "/images/ecoclover.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "house",
        "pages": ["home"]
      },
      {
        "tab": "Economic ID",
        "icon": "id-badge",
        "pages": [
          "whatis",
          {
            "group": "Getting started",
            "pages": ["how-it-works", "signup"]
          },
          {
            "group": "Account",
            "pages": ["managing-account", "ecoverify"]
          },
          {
            "group": "Single sign-on",
            "pages": ["sso-overviewe", "integration"]
          }
        ]
      },
      {
        "tab": "Azura",
        "icon": "hexagon",
        "color": {"light": "#ffc700", "dark": "#ffc700"},
        "pages": [
          "getting-started",
          "artifacts",
          "image-and-file-attachments",
          "managing-conversations",
          "memory",
          "omnibox-and-commands",
          "tips-and-tricks"
        ]
      },
      {
        "tab": "eChat",
        "icon": "message-circle",
        "pages": [
          "echat-intro",
          {
            "group": "Getting started",
            "pages": ["what-is", "creating-account", "installing", "setting-up"]
          },
          {
            "group": "Messaging",
            "pages": ["sending", "rich-media", "reactions", "gifs", "voice"]
          },
          {
            "group": "Calls",
            "pages": ["making-calls", "group-calls", "call-settings"]
          },
          {
            "group": "People and spaces",
            "pages": ["managing", "channels", "creating-groups", "managing-groups"]
          },
          {
            "group": "Settings",
            "pages": ["appearance", "notifications", "privacy"]
          },
          {
            "group": "Tips and tricks",
            "pages": ["tips"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/ecowesternicon(1).png",
    "dark": "/images/ecoclover.png",
    "href": "https://ecowestern.net"
  },
  "navbar": {
    "links": [
      {
        "label": "EcoWestern home",
        "href": "https://ecowestern.net"
      },
      {
        "label": "Status",
        "href": "https://status.ecowestern.net"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Economic ID",
      "href": "https://id.ecowestern.net"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "background": {
    "decoration": "grid"
  },
  "appearance": {
    "default": "system"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "icons": {
    "library": "lucide"
  },
  "search": {
    "prompt": "Ask Azura..."
  },
  "interaction": {
    "drilldown": true
  },
  "seo": {
    "indexing": "navigable"
  },
  "fonts": {
    "family": "Google Sans"
  }
}
